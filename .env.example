# Optional server-side adapters. Never expose tokens in public/ or commit real secrets.
RECONSTRUCTION_ENDPOINT=
RECONSTRUCTION_API_KEY=
LAYOUT_ENDPOINT=
LAYOUT_API_KEY=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Original Sites deployment forwards render calls to the dedicated quota-protected Worker.
RENDER_PROXY_ORIGIN=
# Optional: override the vision model used for floorplan analysis (default DeepSeek).
# All three follow the OpenAI /chat/completions format, so switching to Gemini or Qwen
# is a Secret change only — no code change, no redeploy.
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_PROVIDER=
# Cloudflare Worker secrets, configured in its dashboard only:
# DEEPSEEK_API_KEY (optional text prompt preparation), RENDER_ACCESS_TOKEN (client render code).
# Cloudflare bindings: AI (Workers AI), RENDER_DB (D1).

# Optional renovation quotation LLM (existing repository module).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional second floorplan source. API key defaults to DEEPSEEK_API_KEY only
# when the provider is deepseek and the base is its exact official endpoint.
VISION_MERGE_PROVIDER=
VISION_MERGE_BASE_URL=
VISION_MERGE_MODEL=
VISION_MERGE_API_KEY=
